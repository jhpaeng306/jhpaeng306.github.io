@article{paeng2023coordinate,
  abbr        = {JMAA},
  bibtex_show = {true},
  selected    = {true},
  title       = {Coordinate-Update Algorithms can Efficiently Detect Infeasible Optimization Problems},
  author      = {Paeng, Jinhee and Park, Jisun and Ryu, Ernest K.},
  journal     = {Journal of Mathematical Analysis and Applications},
  year        = {2023},
  note        = {Preprint, under minor revision},
  arxiv       = {2305.12211},
  slides      = {RC_FPI_slides.pdf},
  video       = {https://youtu.be/XR38uybRRuA},
  abstract    = {Analysis of the asymptotic behavior of randomized coordinate fixed-point iterations (RC-FPI) without any fixed points. We prove almost sure convergence of the normalized iterates to the negative infimal displacement vector and establish an asymptotic upper bound on the variance, which yields an infeasibility detection method for randomized FPI-type algorithms.}
}

